{
  "environment": {
    "geoip": {
      "114.114.114.114": "CN",
      "220.181.38.148": "CN",
      "8.8.8.8": "US"
    },
    "dns": {
      "baidu.com": "220.181.38.148",
      "notgoogle.com": "198.51.100.99"
    },
    "live_selected": {
      "Proxy": "jp-1"
    },
    "live_latency_ms": {
      "Auto": { "hk-1": 120, "jp-1": 40 },
      "Streaming": { "jp-1": 50 }
    }
  },
  "cases": [
    { "name": "exact domain reject", "domain": "ads.example.com",
      "expected": { "matched": "rule:0", "target": "REJECT", "group_path": [], "outcome": "reject", "resolved_ip": null } },
    { "name": "suffix subdomain through select default", "domain": "www.google.com",
      "expected": { "matched": "rule:1", "target": "Proxy", "group_path": ["Proxy", "Auto"], "outcome": "node:hk-1", "resolved_ip": null } },
    { "name": "suffix apex", "domain": "google.com",
      "expected": { "matched": "rule:1", "target": "Proxy", "group_path": ["Proxy", "Auto"], "outcome": "node:hk-1", "resolved_ip": null } },
    { "name": "suffix does not match a longer label", "domain": "notgoogle.com",
      "expected": { "matched": "final", "target": "Proxy", "group_path": ["Proxy", "Auto"], "outcome": "node:hk-1", "resolved_ip": "198.51.100.99" } },
    { "name": "failed resolution for an ip rule rejects", "domain": "unresolvable.test",
      "expected": { "matched": "resolve_failed:7", "target": "REJECT", "group_path": [], "outcome": "reject", "resolved_ip": null } },
    { "name": "leading-dot suffix and static fallback", "domain": "api.netflix.com",
      "expected": { "matched": "rule:2", "target": "Streaming", "group_path": ["Streaming"], "outcome": "node:us-1", "resolved_ip": null } },
    { "name": "static url-test uses first member", "domain": "m.youtube.com",
      "expected": { "matched": "rule:3", "target": "Auto", "group_path": ["Auto"], "outcome": "node:hk-1", "resolved_ip": null } },
    { "name": "domain keyword", "domain": "ad.tracker-cdn.net",
      "expected": { "matched": "rule:4", "target": "REJECT", "group_path": [], "outcome": "reject", "resolved_ip": null } },
    { "name": "exact domain direct", "domain": "router.lan",
      "expected": { "matched": "rule:5", "target": "DIRECT", "group_path": [], "outcome": "direct", "resolved_ip": null } },
    { "name": "domain normalization", "domain": "ROUTER.lan.", "engine_only": true,
      "expected": { "matched": "rule:5", "target": "DIRECT", "group_path": [], "outcome": "direct", "resolved_ip": null } },
    { "name": "no-resolve cidr on ip destination", "ip": "192.168.1.10",
      "expected": { "matched": "rule:6", "target": "DIRECT", "group_path": [], "outcome": "direct", "resolved_ip": null } },
    { "name": "ipv6 cidr", "ip": "2001:db8:1::5",
      "expected": { "matched": "rule:7", "target": "Proxy", "group_path": ["Proxy", "Auto"], "outcome": "node:hk-1", "resolved_ip": null } },
    { "name": "domain resolved for geoip", "domain": "baidu.com",
      "expected": { "matched": "rule:8", "target": "DIRECT", "group_path": [], "outcome": "direct", "resolved_ip": "220.181.38.148" } },
    { "name": "geoip on ip destination", "ip": "114.114.114.114",
      "expected": { "matched": "rule:8", "target": "DIRECT", "group_path": [], "outcome": "direct", "resolved_ip": null } },
    { "name": "final for foreign ip", "ip": "8.8.8.8",
      "expected": { "matched": "final", "target": "Proxy", "group_path": ["Proxy", "Auto"], "outcome": "node:hk-1", "resolved_ip": null } },
    { "name": "live select choice", "domain": "www.google.com", "live": true,
      "expected": { "matched": "rule:1", "target": "Proxy", "group_path": ["Proxy"], "outcome": "node:jp-1", "resolved_ip": null } },
    { "name": "live url-test picks lowest latency", "domain": "m.youtube.com", "live": true,
      "expected": { "matched": "rule:3", "target": "Auto", "group_path": ["Auto"], "outcome": "node:jp-1", "resolved_ip": null } },
    { "name": "live fallback skips failed member", "domain": "api.netflix.com", "live": true,
      "expected": { "matched": "rule:2", "target": "Streaming", "group_path": ["Streaming"], "outcome": "node:jp-1", "resolved_ip": null } }
  ]
}
