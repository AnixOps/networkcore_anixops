{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnixOps Net",
  "version": "0.2.0",
  "identifier": "io.anixops.net.linux",
  "build": {
    "beforeDevCommand": "pnpm --dir ../windows-gui/ui dev",
    "beforeBuildCommand": "pnpm --dir ../windows-gui/ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../windows-gui/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnixOps Net",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/networkcore.png"
    ]
  }
}
